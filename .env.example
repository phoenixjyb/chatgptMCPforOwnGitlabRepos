# -----------------------------------------------------------------------------
# GitLab API (used by the read-only ChatGPT MCP)
# -----------------------------------------------------------------------------
GITLAB_BASE_URL=http://gitlab.example.internal

# Keep this API token read-only.
# Recommended scopes: read_api + read_repository
GITLAB_TOKEN=glpat_REPLACE_ME

# Exact comma-separated path_with_namespace values and/or numeric IDs.
# Strongly recommended for v0.1 reads, REQUIRED by default for v0.2 workspaces.
# v0.2 workspace creation uses path_with_namespace such as team/project-a.
GITLAB_ALLOWED_PROJECTS=team/project-a

GITLAB_VERIFY_SSL=true
GITLAB_TRUST_ENV=false
GITLAB_TIMEOUT_SECONDS=30
GITLAB_MAX_TEXT_BYTES=120000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# v0.2 ActualCoder / gitlab-agent local coding workflow
# -----------------------------------------------------------------------------

# Separate Git-over-HTTP credential for clone/push is recommended.
# For read-only workspace creation, read_repository is enough.
# For push / push-mr, this token needs write_repository.
#
# checkout-mr uses GITLAB_TOKEN for read_api metadata lookup.
# If GITLAB_GIT_TOKEN is empty, Git operations fall back to GITLAB_TOKEN.
GITLAB_GIT_TOKEN=
GITLAB_GIT_USERNAME=oauth2

# Ignore ALL_PROXY/HTTP_PROXY/HTTPS_PROXY and ~/.gitconfig http.proxy for
# Git clone/fetch/push by default. Set true only if your GitLab must use them.
GITLAB_GIT_TRUST_ENV=false

# Safety: if true, local/write workspaces cannot be created unless
# GITLAB_ALLOWED_PROJECTS is explicitly configured.
GITLAB_REQUIRE_WRITE_ALLOWLIST=true

# Local cache + isolated task worktrees.
GITLAB_WORKSPACE_ROOT=~/.local/share/chatgpt-gitlab-mcp
GITLAB_BRANCH_PREFIX=chatgpt/
GITLAB_DEFAULT_BASE_REF=main

# Allowlisted executables for build/test commands. Deliberately excludes
# bash, sh, zsh, curl, ssh, sudo and git (Git actions have dedicated commands).
GITLAB_ALLOWED_EXECUTABLES=python,python3,pytest,uv,node,npm,pnpm,yarn,make,cmake,ninja,cargo,go,mvn,gradle

GITLAB_COMMAND_TIMEOUT_SECONDS=300
GITLAB_COMMAND_MAX_OUTPUT_BYTES=120000
GITLAB_MAX_WRITE_FILE_BYTES=1000000

# Optional. If unset, Git uses your existing Git config.
# GITLAB_GIT_AUTHOR_NAME=Your Name
# GITLAB_GIT_AUTHOR_EMAIL=you@example.com
